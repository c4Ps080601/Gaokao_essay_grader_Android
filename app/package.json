{
  "name": "essay-grader-public",
  "version": "3.1.3",
  "description": "续写批改站 Windows 桌面版（浙江高考读后续写批改）",
  "author": "",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:minor": "node scripts/bump-version.js --minor && electron-builder --win nsis",
    "dist:mac": "electron-builder --mac",
    "dist:mac:universal": "node scripts/bump-version.js --minor && electron-builder --mac --universal",
    "build:ui": "vite build frontend --config frontend/vite.config.ts",
    "check:ui": "tsc --project frontend/tsconfig.json",
    "dev:ui": "vite frontend --config frontend/vite.config.ts",
    "predev": "npm run build:ui",
    "prepack": "npm run build:ui",
    "predist": "npm run build:ui",
    "test:ui": "node test/mobile-ui.cjs",
    "prestart": "npm run build:ui",
    "setup:electron": "node node_modules/electron/install.js",
    "format:ui": "prettier --write frontend/src --ignore-path ../.gitignore frontend/vite.config.ts",
    "predist:minor": "npm run build:ui",
    "predist:mac": "npm run build:ui",
    "predist:mac:universal": "npm run build:ui",
    "generate:mobile-core": "node scripts/generate-mobile-core.cjs",
    "prebuild:ui": "npm run generate:mobile-core",
    "predev:ui": "npm run generate:mobile-core",
    "android:sync": "npm run build:ui && cap sync android",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-android.ps1",
    "test:android": "npm run generate:mobile-core && node --test test/android-runtime.test.cjs",
    "pretest": "npm run generate:mobile-core"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "express": "^4.19.2",
    "html-to-image": "^1.11.13",
    "motion": "14.4.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.49.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "build": {
    "appId": "org.essaygrader.public",
    "productName": "续写批改站公开版",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "grader.js",
      "rubric.js",
      "store.js",
      "settings.js",
      "pdf-export.js",
      "preload.js",
      "config.json",
      "public/**/*",
      "providers.js",
      "build/icon.ico",
      "mobile-dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "darkModeSupport": true
    },
    "afterPack": "./scripts/after-pack.js",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "续写批改站公开版",
      "differentialPackage": false
    }
  }
}
